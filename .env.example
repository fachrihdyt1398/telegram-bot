# Token dari @BotFather di Telegram
BOT_TOKEN=123456:ABC-DEF...

# URL project Vercel-mu (tanpa /api/webhook, script akan menambah sendiri)
WEBHOOK_URL=https://nama-proyek.vercel.app

# Gembok webhook — string acak panjang, HARUS SAMA dengan yang di set di Vercel
WEBHOOK_SECRET=ganti-dengan-string-acak-panjang

# --- Cloudflare KV (memori permanen bot) ---
# Token API dengan permission KV storage (Read & Write)
CLOUDFLARE_KV_TOKEN=
# Account ID (sama seperti yang dipakai untuk Workers AI)
CLOUDFLARE_ACCOUNT_ID=
# ID namespace KV bernama "tgbot-state"
CLOUDFLARE_KV_NAMESPACE_ID=

# --- AI Provider (set minimal satu) ---

# Google Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (gratis): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI (gratis): https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# OpenRouter (gratis): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# (Opsional) Urutan fallback per provider, pisahkan dengan koma. Contoh: Gemini,Groq,OpenRouter,Cloudflare
# AI_PROVIDERS=

# (Opsional) Urutan fallback PER-MODEL, format: Provider:model, pisahkan dengan koma.
# Model pertama = prioritas tertinggi. Jika kena limit, otomatis pindah ke model berikutnya.
# Contoh:
# AI_MODELS=OpenRouter:google/gemma-4-31b-it:free,Gemini:gemini-3.6-flash,Groq:llama-3.3-70b-versatile,Cloudflare:@cf/meta/llama-3.1-8b-instruct
